# Service principal con rol "Cost Management Reader"
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Opcional: limitar a estas suscripciones (IDs separados por coma). Vacío = todas las accesibles
AZURE_SUBSCRIPTION_IDS=

# Análisis IA: gemini | kimi
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
KIMI_API_KEY=

# Salida local (por defecto src/assets/data y etl/raw)
OUTPUT_DIR=
RAW_DIR=

# Salida en Blob Storage: si ambos están definidos se ignora OUTPUT_DIR
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=
AZURE_STORAGE_RAW_CONTAINER=raw
