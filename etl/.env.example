# Service principal con rol "Cost Management Reader"
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Opcional: limitar a estas suscripciones (IDs separados por coma). Vacío = todas las accesibles
AZURE_SUBSCRIPTION_IDS=

# Análisis IA: gemini | llmhub
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# llmhub (Azure OpenAI vía llmhub_uniandes): solo NOMBRES de secretos en Key Vault, nunca los valores.
# El service principal de arriba necesita el rol "Key Vault Secrets User" en ese vault.
AZURE_KEY_VAULT_URI=
LLM_SECRET_API_KEY=
LLM_SECRET_ENDPOINT=
LLM_MODEL_NAME=gpt-5.6-terra
LLM_API_VERSION=
LLM_MAX_TOKENS=4000

# Salida local (por defecto src/assets/data y etl/raw)
OUTPUT_DIR=
RAW_DIR=

# Salida en Blob Storage: si ambos están definidos se ignora OUTPUT_DIR
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=
AZURE_STORAGE_RAW_CONTAINER=raw
